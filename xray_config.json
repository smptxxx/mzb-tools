{
  "log": {
    "loglevel": "warning",
    "access": "/var/lib/marzban/access.log"
  },
  "routing": {
    "rules": [
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK",
        "type": "field"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "VLESS TCP TLS 443",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none",
        "fallbacks": [
          {
            "path": "/vless-ws",
            "dest": "/dev/shm/vless-ws-443.sock",
            "xver": 1
          },
          {
            "path": "/vmess-ws",
            "dest": "/dev/shm/vmess-ws-443.sock",
            "xver": 1
          },
          {
            "path": "/trojan-ws",
            "dest": "/dev/shm/trojan-ws-443.sock",
            "xver": 1
          },
          {
            "path": "/ss-ws",
            "dest": "/dev/shm/shadowsocks-ws-443.sock",
            "xver": 1
          },
          {
            "path": "/ssh-ws",
            "dest": "127.0.0.1:10015",
            "xver": 0
          },
          {
            "path": "/apix",
            "dest": "127.0.0.1:8901",
            "xver": 0
          },
          {
            "path": "/",
            "dest": "127.0.0.1:10015",
            "xver": 0
          },
          {
            "dest": "127.0.0.1:8901",
            "xver": 0
          },
