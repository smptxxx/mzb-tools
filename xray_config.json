            "xver": 1
          },
          {
            "path": "/shadowsocks-hu",
            "dest": "/dev/shm/shadowsocks-hu-443.sock",
            "xver": 1
          },
          {
            "path": "/vless-xh",
            "dest": "/dev/shm/vless-xh-443.sock",
            "xver": 1
          },
          {
            "path": "/vmess-xh",
            "dest": "/dev/shm/vmess-xh-443.sock",
            "xver": 1
