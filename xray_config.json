        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "/var/lib/marzban/certs/fullchain.pem",
              "keyFile": "/var/lib/marzban/certs/key.pem"
            }
          ],
          "alpn": [
            "http/1.1"
          ],
          "minVersion": "1.2"
        }
      }
    },
    {
      "tag": "VLESS WS 443",
